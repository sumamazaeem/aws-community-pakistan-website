---
import { assetUrl } from '../lib/assets';

interface Props {
  name: string;
  /** Normalised role, where the record has one. Event volunteers do not. */
  role?: string | null;
  label?: string | null;
  linkedin?: string | null;
  photo?: string | null;
}

const { name, role, label, linkedin, photo } = Astro.props;

const image = assetUrl(photo);

// `label` is the wording the existing page used, so it is preferred over the
// normalised role. Where the page gave no role at all the record says
// `unspecified` (or nothing), and that is stated plainly rather than invented.
const roleText =
  label ??
  (!role || role === 'unspecified' ? 'Role not recorded' : role.replace(/-/g, ' '));
---

<li class="person">
  {
    image ? (
      <img class="person__photo" src={image} alt={name} loading="lazy" width="110" height="110" />
    ) : (
      <span class="person__photo person__photo--empty" aria-hidden="true"></span>
    )
  }
  <h3 class="person__name">
    {
      linkedin ? (
        <a href={linkedin} target="_blank" rel="noopener noreferrer">{name}</a>
      ) : (
        name
      )
    }
  </h3>
  <p class="person__role">{roleText}</p>
</li>
